# คัดลอกเป็น Environment Variables ใน Vercel (ห้ามใส่ค่าจริงลงในไฟล์ที่ commit)
SEND_MODE=dryrun              # dryrun = ไม่ส่งจริง | staff_only = ส่งเฉพาะเจ้าหน้าที่ | live = ส่งทุกกลุ่ม
ALLOW_PATIENT_MESSAGES=false  # ต้องเป็น true พร้อม SEND_MODE=live จึงจะส่งหาผู้ป่วย/ผู้ดูแลได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
SEND_API_KEY=                 # รหัสลับที่ผู้เรียก /api/send ต้องส่งมาใน header x-api-key
STAFF_USER_IDS=               # LINE userId ของบุคลากรทดลองใช้ คั่นด้วยจุลภาค
