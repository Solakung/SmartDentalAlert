rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole() { return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return hasRole() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    // บทบาทกำหนดใน Firebase Console เท่านั้น (client เขียนไม่ได้) ผู้ใช้อ่านได้เฉพาะของตัวเอง
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /appointments/{id} {
      allow read: if hasRole();
      // ผู้มีสิทธิ์สร้างนัดได้เฉพาะฟิลด์ที่กำหนด รหัสต้องเป็นรหัสวิจัย (กันชื่อ/ข้อมูลระบุตัวตนหลุดเข้ามา)
      allow create: if hasRole()
        && request.resource.data.keys().hasOnly(['id','date','period','proc','age','sex','marital','scheme','outArea','lead','dow','priorNs','priorAp','chronic','cont','outcome','done','createdAt'])
        && request.resource.data.id is string && request.resource.data.id.matches('^P[0-9]{3,6}$')
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.period in ['morning','afternoon']
        && request.resource.data.sex in ['F','M']
        && request.resource.data.marital in ['single','married','widowed','divorced']
        && request.resource.data.scheme in ['UC','civil','social']
        && request.resource.data.proc in ['scaling','extraction','filling','denture']
        && request.resource.data.outArea in [0,1] && request.resource.data.chronic in [0,1] && request.resource.data.cont in [0,1]
        && request.resource.data.age is int && request.resource.data.age >= 60 && request.resource.data.age <= 110
        && request.resource.data.lead is int && request.resource.data.lead >= 0 && request.resource.data.lead <= 365
        && request.resource.data.dow is int && request.resource.data.dow >= 0 && request.resource.data.dow <= 4
        && request.resource.data.priorAp is int && request.resource.data.priorAp >= 0 && request.resource.data.priorAp <= 500
        && request.resource.data.priorNs is int && request.resource.data.priorNs >= 0 && request.resource.data.priorNs <= request.resource.data.priorAp
        && (request.resource.data.outcome == null || request.resource.data.outcome in ['came','noshow']);
      allow delete: if isAdmin();
      // เจ้าหน้าที่แก้ได้เฉพาะผลการมาและรายการมาตรการที่ทำแล้ว
      allow update: if isAdmin() || (hasRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outcome','done','reason','reasonNote','updatedAt','updatedBy'])
        && (request.resource.data.outcome == null || request.resource.data.outcome in ['came','noshow'])
        && (request.resource.data.get('reason', null) == null || request.resource.data.reason in ['forgot','travel','no_escort','sick','busy','afraid','other'])
        && (request.resource.data.get('reasonNote', null) == null || (request.resource.data.reasonNote is string && request.resource.data.reasonNote.size() <= 100)));
    }

    match /settings/{name} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
  }
}
